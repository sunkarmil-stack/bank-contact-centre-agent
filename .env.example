# ---- environment ----
CCAGENT_ENV=local                     # local | dev | test | prod (prod enforces fail-fast guard rails)
CCAGENT_DATA_DIR=./.data

# ---- model: offline (default, no keys) or Microsoft Foundry ----
CCAGENT_LLM_PROVIDER=offline          # offline | azure_foundry
# AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21
# Authentication uses DefaultAzureCredential (az login locally, managed identity in Azure). No API keys.

# ---- retrieval ----
CCAGENT_RETRIEVER=local               # local | azure_ai_search
# AZURE_SEARCH_ENDPOINT=https://<search>.search.windows.net
# AZURE_SEARCH_INDEX=contact-centre-kb

# ---- enterprise systems ----
CCAGENT_CUSTOMER_SERVICE=mock         # mock | http
# CUSTOMER_API_BASE_URL=https://apim.internal.example/customer/v1
CCAGENT_CASE_SERVICE=local            # local | http
# CASE_API_BASE_URL=http://127.0.0.1:8102
CCAGENT_SERVICE_AUTH=local            # local (signed dev service tokens) | azure (managed identity + Entra app roles)
CCAGENT_REQUIRE_GATEWAY=false         # true: /v1 accepted only with the gateway's proof of entry
# CCAGENT_AUDIT_DB_PATH=./.data/audit.db   shared audit store for all services
CCAGENT_MCP_MODE=inprocess            # inprocess | http
# python -m scripts.run_all sets all of the above for the five-service layout.
# CCAGENT_MCP_URL=http://127.0.0.1:8765/mcp

# ---- persistence ----
CCAGENT_PERSISTENCE=sqlite            # sqlite | postgres
# CCAGENT_SECRET_POSTGRES_DSN=postgresql://...   (prod: from Key Vault secret "postgres-dsn")

# ---- identity ----
CCAGENT_AUTH_MODE=dev                 # dev | entra
# ENTRA_TENANT_ID=<tenant-guid>
# ENTRA_AUDIENCE=api://ccagent-api

# ---- secrets (prod: set AZURE_KEY_VAULT_URL instead; dev: auto-generated into .data/.dev-secrets.json) ----
# AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net
# CCAGENT_SECRET_CHECKPOINT_ENCRYPTION_KEY=<base64 32 bytes>

# ---- observability ----
CCAGENT_OTEL_EXPORTER=none            # none | console | otlp | azure_monitor
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=ccagent

# ---- business policy ----
CCAGENT_DISPUTE_REVIEW_THRESHOLD_CAD=500
CCAGENT_INTENT_CONFIDENCE_FLOOR=0.55
CCAGENT_COMPLAINT_ACK_SLA_HOURS=48
